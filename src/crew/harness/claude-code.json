{
  "id": "claude-code",
  "name": "Claude Code",
  "live": "verified",
  "paths": [".claude/settings.json", ".claude/el-capitan/", ".claude/agents/", ".claude/skills/"],
  "events": {
    "session_start": {"native": "SessionStart"},
    "prompt_submit": {"native": "UserPromptSubmit"},
    "pre_shell": {"native": "PreToolUse", "matcher": "Bash"},
    "pre_write": {"native": "PreToolUse", "matcher": "Write|Edit|MultiEdit"},
    "post_tool": {"native": ["PostToolUse", "PostToolUseFailure"], "matcher": "Bash|Write|Edit"},
    "post_shell": {"native": "PostToolUse", "matcher": "Bash"},
    "subagent_stop": {"native": "SubagentStop"},
    "stop": {"native": "Stop"},
    "idle": {"native": "Notification", "matcher": "idle_prompt"}
  },
  "deny": {
    "modes": {"*": true},
    "why": "permissions.deny and ask hold in default, headless (-p), background and bypassPermissions modes (docs/hooks.md, Harness facts)"
  },
  "always_on": {"value": "~/.claude/CLAUDE.md imports each always-on rule from ~/.claude/el-capitan"},
  "rules": {"value": "~/.claude/el-capitan/<rule>.md, read by the imports and the Read pointers"},
  "agents": {"value": "~/.claude/agents/<agent>.md"},
  "skills": {"value": "~/.claude/skills/<skill>"},
  "access": {
    "readonly": "frontmatter tools: the class list plus the MCP servers",
    "probe": "frontmatter tools: with Write and Bash",
    "worker": "every tool (no tools: line)",
    "inline": "read and run in the main session (.claude/CLAUDE.md, Invocation)"
  },
  "max_turns": {"value": "frontmatter maxTurns"},
  "mcp": {"value": "frontmatter tools: one mcp__<server>__* per configured server"},
  "permissions": {
    "allow": [
      "Bash(jq *)",
      "Bash(cd *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git blame *)",
      "Bash(git remote -v)",
      "Bash(git stash list *)",
      "Bash(git describe *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git switch -c *)",
      "Bash(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create --repo *)",
      "Bash(gh api -X GET *)",
      "Bash(gh api --method GET *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(test *)",
      "Bash(uuidgen)",
      "Bash(date *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(~/.agent/bin/crew-ls.py *)",
      "Bash(~/.agent/bin/crew-doctor.py *)",
      "Bash(~/.agent/bin/crew-task.py mark-implementing *)",
      "Bash(~/.agent/bin/crew-task.py reconcile *)",
      "Bash(~/.agent/bin/crew-task.py normalize-status *)",
      "Bash(~/.agent/bin/crew-task.py lock *)",
      "Bash(~/.agent/bin/crew-task.py blocked *)",
      "Bash(~/.agent/bin/crew-task.py worktree *)",
      "Bash(~/.agent/bin/crew-verify.py report-check *)",
      "Bash(~/.agent/bin/crew-mem.py *)",
      "Bash(~/.agent/bin/crew-inbox.py *)",
      "Bash(~/.agent/bin/crew-review-findings.py *)",
      "Bash(~/.agent/bin/crew-task-context.py *)",
      "Bash(~/.agent/bin/crew-agent-context.py *)",
      "Bash(~/.agent/bin/crew-worktree.py *)",
      "Bash(bash .claude/hooks/fixtures/*)",
      "Bash(agent-builder *)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Edit(~/.agent/tasks/**)"
    ],
    "deny": ["Bash(gh pr checkout*)", "Bash(gh pr co *)"],
    "additionalDirectories": ["~/.agent/tasks"]
  }
}
