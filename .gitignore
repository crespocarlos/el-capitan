# Journal and profile live outside git (personal data)
.agent/journal/
.agent/PROFILE.md
.agent/vectorstore/

# Python bytecode and the dev environment (`uv sync`)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Per-run local state: task specs, review scratch, and anything else a crew command writes.
# Everything under .agent/ except the templates is runtime state, so ignore the directory
# wholesale and re-include what belongs in the repo. A named list was how two
# task artifacts got committed and later swept away by a `git add -A`.
.agent/*
!.agent/_SPEC_TEMPLATE.md
!.agent/_BUG_SPEC_TEMPLATE.md
!.agent/_MEMORY_TEMPLATE.md
!.agent/_JOURNAL_TEMPLATE.md

# Local-only overrides — never commit
.claude/settings.local.json
.claude/worktrees/
.ruff_cache/
snapshot_report.html
