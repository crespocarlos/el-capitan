{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {"command": "bash \"$HOME/.claude/hooks/cursor-memory-context.sh\""},
      {"command": "bash \"$HOME/.claude/hooks/probe.sh\" cursor sessionStart"}
    ],
    "beforeShellExecution": [
      {"command": "bash \"$HOME/.claude/hooks/guard/destructive-git.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/guard/local-pr-ref.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/guard/source-edit.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/guard/task-files.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/guard/owner-only.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/guard/zsh-equals.sh\"", "failClosed": false},
      {"command": "bash \"$HOME/.claude/hooks/guard/worker-tree.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/guard/credentials.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/probe.sh\" cursor beforeShellExecution"}
    ],
    "preToolUse": [
      {"matcher": "Write|Edit", "command": "bash \"$HOME/.claude/hooks/check-write-boundary.sh\"", "failClosed": true},
      {"matcher": "Write|Edit", "command": "bash \"$HOME/.claude/hooks/check-task-spec-owner.sh\"", "failClosed": true},
      {"command": "bash \"$HOME/.claude/hooks/probe.sh\" cursor preToolUse"}
    ],
    "afterFileEdit": [{"command": "bash \"$HOME/.claude/hooks/probe.sh\" cursor afterFileEdit"}],
    "subagentStart": [{"command": "bash \"$HOME/.claude/hooks/probe.sh\" cursor subagentStart"}],
    "subagentStop": [{"command": "bash \"$HOME/.claude/hooks/probe.sh\" cursor subagentStop"}],
    "afterShellExecution": [{"command": "bash \"$HOME/.claude/hooks/record-pr.sh\" 2>/dev/null; exit 0"}],
    "postToolUse": [{"command": "bash \"$HOME/.claude/hooks/log-tool-use.sh\""}],
    "postToolUseFailure": [{"command": "bash \"$HOME/.claude/hooks/log-tool-use.sh\""}],
    "stop": [
      {"command": "bash \"$HOME/.claude/hooks/memory-capture-prompt.sh\"", "loop_limit": 1},
      {"command": "bash \"$HOME/.claude/hooks/probe.sh\" cursor stop"}
    ]
  }
}
