{
  "version": 1,
  "hooks": {
    "sessionStart": [{"command": "bash \"$HOME/.claude/hooks/cursor-memory-context.sh\"", "timeout": 30}],
    "beforeShellExecution": [
      {"command": "bash \"$HOME/.claude/hooks/guard/destructive-git.sh\"", "failClosed": true, "timeout": 10},
      {"command": "bash \"$HOME/.claude/hooks/guard/local-pr-ref.sh\"", "failClosed": true, "timeout": 10},
      {"command": "bash \"$HOME/.claude/hooks/guard/source-edit.sh\"", "failClosed": true, "timeout": 10},
      {"command": "bash \"$HOME/.claude/hooks/guard/task-files.sh\"", "failClosed": true, "timeout": 10},
      {"command": "bash \"$HOME/.claude/hooks/guard/owner-only.sh\"", "failClosed": true, "timeout": 10},
      {"command": "bash \"$HOME/.claude/hooks/guard/zsh-equals.sh\"", "failClosed": false, "timeout": 10},
      {"command": "bash \"$HOME/.claude/hooks/guard/worker-tree.sh\"", "failClosed": true, "timeout": 10},
      {"command": "bash \"$HOME/.claude/hooks/guard/credentials.sh\"", "failClosed": true, "timeout": 10}
    ],
    "preToolUse": [
      {"matcher": "Write|Edit", "command": "bash \"$HOME/.claude/hooks/check-write-boundary.sh\"", "failClosed": true, "timeout": 10},
      {"matcher": "Write|Edit|Delete", "command": "bash \"$HOME/.claude/hooks/check-task-spec-owner.sh\"", "failClosed": true, "timeout": 10}
    ],
    "afterShellExecution": [{"command": "bash \"$HOME/.claude/hooks/record-pr.sh\" 2>/dev/null; exit 0", "timeout": 30}],
    "postToolUse": [{"command": "bash \"$HOME/.claude/hooks/log-tool-use.sh\"", "timeout": 30}],
    "postToolUseFailure": [{"command": "bash \"$HOME/.claude/hooks/log-tool-use.sh\"", "timeout": 30}],
    "subagentStop": [{"command": "bash \"$HOME/.claude/hooks/capture-reply.sh\"", "loop_limit": 1, "timeout": 30}],
    "stop": [
      {"command": "bash \"$HOME/.claude/hooks/memory-capture-prompt.sh\"", "loop_limit": 1, "timeout": 30},
      {"command": "bash \"$HOME/.claude/hooks/cursor-usage.sh\"", "timeout": 30}
    ]
  }
}
