{
  "permissions": {
    "allow": [
      "Bash(jq *)",
      "Bash(cd *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git blame *)",
      "Bash(git remote -v)",
      "Bash(git stash list *)",
      "Bash(git describe *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git switch -c *)",
      "Bash(git push *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create --repo *)",
      "Bash(gh api -X GET *)",
      "Bash(gh api --method GET *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(test *)",
      "Bash(uuidgen)",
      "Bash(date *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(~/.agent/bin/crew-ls.py *)",
      "Bash(~/.agent/bin/crew-doctor.py *)",
      "Bash(~/.agent/bin/crew-task.py mark-implementing *)",
      "Bash(~/.agent/bin/crew-task.py reconcile *)",
      "Bash(~/.agent/bin/crew-task.py normalize-status *)",
      "Bash(~/.agent/bin/crew-task.py lock *)",
      "Bash(~/.agent/bin/crew-task.py blocked *)",
      "Bash(~/.agent/bin/crew-task.py worktree *)",
      "Bash(~/.agent/bin/crew-verify.py report-check *)",
      "Bash(~/.agent/bin/crew-mem.py *)",
      "Bash(~/.agent/bin/crew-inbox.py *)",
      "Bash(~/.agent/bin/crew-review-findings.py *)",
      "Bash(~/.agent/bin/crew-task-context.py *)",
      "Bash(~/.agent/bin/crew-agent-context.py *)",
      "Bash(~/.agent/bin/crew-worktree.py *)",
      "Bash(bash .claude/hooks/fixtures/*)",
      "Bash(agent-builder *)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Edit(~/.agent/tasks/**)"
    ],
    "ask": [
      "Edit(~/.agent/tasks/*/SPEC.md)"
    ],
    "deny": [
      "Bash(gh pr checkout*)",
      "Bash(gh pr co *)"
    ],
    "additionalDirectories": [
      "~/.agent/tasks"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "bash \"$HOME/.claude/hooks/guard/shell.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "bash \"$HOME/.claude/hooks/check-task-spec-owner.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/log-tool-use.sh\" 2>/dev/null; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/record-pr.sh\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/log-tool-use.sh\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/notify-idle.sh\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/memory-context.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/agents-refresh.sh\"; exit 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/spec-status-reconcile.sh\"; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/memory-capture-prompt.sh\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/capture-reply.sh\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "bash \"$HOME/.claude/hooks/mode-anchor.sh\""
          }
        ]
      }
    ]
  }
}
